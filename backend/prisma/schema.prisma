generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String
  passwordHash String
  role         String     @default("USER")
  createdAt    DateTime   @default(now())
  properties   Property[]
  favorites    Favorite[]
}

model Property {
  id                String     @id @default(cuid())
  code              Int        @unique
  title             String
  description       String
  dealType          String     // SALE, RENT, DAILY, MORTGAGE
  propertyType      String     // APARTMENT, HOUSE, COMMERCIAL, LAND
  status            String     @default("NEW_BUILDING")
  condition         String     @default("NEW_RENOVATED")
  city              String
  district          String
  address           String
  priceUsd          Float
  area              Float
  rooms             Int
  bedrooms          Int
  bathrooms         Int        @default(1)
  floor             Int
  totalFloors       Int
  hasBalcony        Boolean    @default(true)
  hasParking        Boolean    @default(false)
  hasElevator       Boolean    @default(true)
  hasCentralHeating Boolean    @default(true)
  isVip             Boolean    @default(false)
  vipType           String?
  images            String
  views             Int        @default(0)
  createdAt         DateTime   @default(now())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites         Favorite[]
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}
